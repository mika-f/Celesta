{
  // Type-checks the component module with the options of the project
  // TypeScript support (packages/cli's project-types), which ../build.mjs
  // checks its declarations against; `react` and `@celesta/*` come from the
  // workspace. build.mjs emits the module and its declarations itself.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src"]
}
