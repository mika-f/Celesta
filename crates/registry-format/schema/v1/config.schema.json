{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.celesta.studio/schema/v1/config.schema.json",
  "title": "Registry config",
  "type": "object",
  "required": [
    "format",
    "generated",
    "api",
    "keys"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "generated": {
      "$ref": "#/$defs/timestamp"
    },
    "api": {
      "type": "string",
      "format": "uri"
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "keyid",
          "public",
          "expires",
          "signature"
        ],
        "properties": {
          "keyid": {
            "type": "string",
            "minLength": 1
          },
          "public": {
            "$ref": "#/$defs/key"
          },
          "expires": {
            "$ref": "#/$defs/timestamp"
          },
          "signature": {
            "$ref": "#/$defs/signature"
          }
        }
      }
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$",
      "description": "32 bytes in canonical standard base64 with padding (44 characters)."
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{85}[AQgw]==$",
      "description": "64 bytes in canonical standard base64 with padding (88 characters)."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
      "description": "RFC 3339 in UTC with whole seconds, exactly YYYY-MM-DDTHH:MM:SSZ: no other offset and no fractional seconds."
    }
  }
}
