{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.celesta.studio/schema/v1/config.schema.json",
  "title": "Registry config",
  "type": "object",
  "required": [
    "format",
    "api",
    "keys"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "api": {
      "type": "string",
      "format": "uri"
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "keyid",
          "public",
          "expires",
          "signature"
        ],
        "properties": {
          "keyid": {
            "type": "string",
            "minLength": 1
          },
          "public": {
            "$ref": "#/$defs/base64"
          },
          "expires": {
            "$ref": "#/$defs/timestamp"
          },
          "signature": {
            "$ref": "#/$defs/base64"
          }
        }
      }
    }
  },
  "$defs": {
    "base64": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "minLength": 4,
      "description": "Standard base64 with padding."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
      "description": "RFC 3339, UTC."
    }
  }
}
