{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.celesta.studio/schema/v1/search.schema.json",
  "title": "Search index",
  "type": "object",
  "required": [
    "format",
    "generated",
    "plugins"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "generated": {
      "$ref": "#/$defs/timestamp"
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "publisher",
          "kind",
          "description",
          "latest",
          "deprecated"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "$ref": "#/$defs/kind"
          },
          "description": {
            "type": "string"
          },
          "latest": {
            "oneOf": [
              {
                "$ref": "#/$defs/version"
              },
              {
                "type": "null"
              }
            ]
          },
          "deprecated": {
            "$ref": "#/$defs/deprecated"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*(\\.[a-z0-9][a-z0-9_-]*)?$",
      "description": "A dotless first-party name, or <publisher>.<name>. Lowercase ASCII letters, digits, '-' and '_', each part starting with a letter or digit; at most one '.'."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
      "description": "RFC 3339 in UTC with whole seconds, exactly YYYY-MM-DDTHH:MM:SSZ: no other offset and no fractional seconds."
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "kind": {
      "type": "object",
      "required": [
        "roles",
        "program",
        "module"
      ],
      "properties": {
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "program": {
          "type": "boolean"
        },
        "module": {
          "type": "boolean"
        }
      }
    },
    "deprecated": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "message",
            "replacement"
          ],
          "properties": {
            "message": {
              "type": "string"
            },
            "replacement": {
              "oneOf": [
                {
                  "$ref": "#/$defs/id"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      ]
    }
  }
}
