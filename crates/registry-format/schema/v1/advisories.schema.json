{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.celesta.studio/schema/v1/advisories.schema.json",
  "title": "Advisories",
  "type": "object",
  "required": [
    "format",
    "generated",
    "advisories"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "generated": {
      "$ref": "#/$defs/timestamp"
    },
    "advisories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "plugin",
          "versions",
          "title",
          "description",
          "fixed",
          "published"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CELESTA-[0-9]{4}-[0-9]{4,}$"
          },
          "plugin": {
            "$ref": "#/$defs/id"
          },
          "versions": {
            "type": "string",
            "pattern": "^[ ]*(=|<=|>=|<|>)[ ]*[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?([ ]*,[ ]*(=|<=|>=|<|>)[ ]*[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?)*[ ]*$",
            "description": "Plain comparators (=, <, <=, >, >=) with a full major.minor.patch, joined by ','. No ^, ~, * or bare versions."
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "fixed": {
            "oneOf": [
              {
                "$ref": "#/$defs/version"
              },
              {
                "type": "null"
              }
            ]
          },
          "published": {
            "$ref": "#/$defs/timestamp"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*(\\.[a-z0-9][a-z0-9_-]*)?$",
      "description": "A dotless first-party name, or <publisher>.<name>. Lowercase ASCII letters, digits, '-' and '_', each part starting with a letter or digit; at most one '.'."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
      "description": "RFC 3339, UTC."
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    }
  }
}
