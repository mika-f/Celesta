{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.celesta.studio/schema/v1/signature.schema.json",
  "title": "Detached signature",
  "type": "object",
  "required": [
    "keyid",
    "signature"
  ],
  "properties": {
    "keyid": {
      "type": "string",
      "minLength": 1
    },
    "signature": {
      "$ref": "#/$defs/base64"
    }
  },
  "$defs": {
    "base64": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "minLength": 4,
      "description": "Standard base64 with padding."
    }
  }
}
