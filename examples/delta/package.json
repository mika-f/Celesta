{
  "name": "@celesta/example-delta",
  "private": true,
  "scripts": {
    "score": "python3 make-score-0.9.0.py",
    "export": "celesta-exporter --json --react --overwrite --loudness streaming film-0.9.0.tsx delta-0.9.0.mp4 --subtitles 'delta-0.9.0.{lang}.srt' --subtitles 'delta-0.9.0.{lang}.vtt'",
    "poster": "celesta-exporter --json --react --overwrite --composition poster film-0.9.0.tsx --frame 0 --quality 85 poster-0.9.0.jpg",
    "export:shorts": "celesta-exporter --json --react --overwrite --loudness streaming shorts-0.9.0.tsx delta-0.9.0-shorts.mp4",
    "score:0.8.0": "python3 make-score-0.8.0.py",
    "export:0.8.0": "celesta-exporter --json --react --overwrite film-0.8.0.tsx delta-0.8.0.mp4 --subtitles 'delta-0.8.0.{lang}.srt' --subtitles 'delta-0.8.0.{lang}.vtt'",
    "export:0.8.0:shorts": "celesta-exporter --json --react --overwrite shorts-0.8.0.tsx delta-0.8.0-shorts.mp4",
    "score:0.7.0": "python3 make-score-0.7.0.py",
    "export:0.7.0": "celesta-exporter --json --react --overwrite film-0.7.0.tsx delta-0.7.0.mp4 --subtitles 'delta-0.7.0.{lang}.srt' --subtitles 'delta-0.7.0.{lang}.vtt'",
    "export:0.7.0:shorts": "celesta-exporter --json --react --overwrite shorts-0.7.0.tsx delta-0.7.0-shorts.mp4",
    "score:0.6.0": "python3 make-score-0.6.0.py",
    "export:0.6.0": "celesta-exporter --json --react --overwrite film-0.6.0.tsx delta-0.6.0.mp4",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@celesta/character": "workspace:*",
    "@celesta/code": "workspace:*",
    "@celesta/components": "workspace:*",
    "@celesta/debug": "workspace:*",
    "@celesta/layout": "workspace:*",
    "@celesta/lottie": "workspace:*",
    "@celesta/math": "workspace:*",
    "@celesta/media-utils": "workspace:*",
    "@celesta/react": "workspace:*",
    "@celesta/shader": "workspace:*",
    "@celesta/shapes": "workspace:*",
    "@celesta/text": "workspace:*",
    "@celesta/transitions": "workspace:*",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^5.7.3"
  }
}
