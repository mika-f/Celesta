{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "worker-configuration.d.ts"]
    },
    "codegen": {
      "inputs": [
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/.cargo/config.toml",
        "$TURBO_ROOT$/crates/composition/**",
        "$TURBO_ROOT$/crates/project/**"
      ],
      "outputs": ["src/generated/**"],
      "outputLogs": "new-only",
      "passThroughEnv": [
        "CARGO_*",
        "RUSTUP_*",
        "RUSTC_*",
        "RUSTFLAGS",
        "RUSTDOCFLAGS"
      ]
    },
    "@celesta.studio/cli#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "worker-configuration.d.ts"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/resolve-package-manifest.mjs",
        "$TURBO_ROOT$/templates/**"
      ]
    },
    "@celesta.studio/react#build": {
      "dependsOn": ["codegen", "^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/.cargo/config.toml",
        "$TURBO_ROOT$/crates/composition/**",
        "$TURBO_ROOT$/crates/project/**"
      ]
    }
  }
}
