{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "worker-configuration.d.ts"]
    },
    "codegen": {
      "cache": false
    },
    "@celesta/react#build": {
      "dependsOn": ["codegen", "^build"]
    }
  }
}
