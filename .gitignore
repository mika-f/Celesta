node_modules/
.turbo/
/projects
/target
# First-party plugins build in a workspace of their own (plugins/Cargo.toml),
# into plugins/target and plugins/dist. A plugin left out of that workspace
# builds into its own target/, and the plugin's older layout built into
# plugins/vrm/target and plugins/vrm/dist.
/plugins/target
/plugins/dist
/plugins/*/target
/plugins/*/dist
/plugins/vrm/assets
*.celesta.json~

*.mp3
*.mp4
*.wav

# Template sample media is part of the templates.
!templates/*/assets/**
# The voice-folder example stands in for a speech tool's export.
!examples/assets/voice-folder/**/*.wav
# The green-screen example's footage is generated and kept small.
!examples/greenscreen/assets/*.mp4

# Voices prepareNarration() synthesized for the examples.
**/.celesta/voices/

# Repository files copied into crates for publishing (scripts/bundle-crate-files.mjs).
/crates/*/bundled/

# Python bytecode
__pycache__/
