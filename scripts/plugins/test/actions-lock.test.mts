import { spawnSync } from 'node:child_process';
import { cpSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { dirname, join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

import { afterEach, beforeEach, describe, expect, it } from 'vitest';

import { LOCK_PATH, checkActionsLock, classifyUses, parseActionsLock, usesValues } from '../actions-lock.mts';

const repository = resolve(dirname(fileURLToPath(import.meta.url)), '..', '..', '..');
const script = join(repository, 'scripts', 'check-actions-lock.mts');

describe('usesValues', () => {
  it('reads step and job uses, quoted or not, and skips comments and other keys', () => {
    const workflow = [
      'jobs:',
      '  build:',
      "    uses: './.github/workflows/package-build.yml'",
      '  test:',
      '    steps:',
      '      - uses: actions/checkout@v7.0.1 # the checkout',
      '      - name: FFmpeg',
      '        uses: "$/.github/actions/setup-ffmpeg"',
      '      # - uses: commented/out@v1',
      '      - run: echo uses: nothing@v1',
      '        with:',
      '          reuses: not/this@v1',
    ].join('\n');
    expect(usesValues(workflow)).toEqual([
      './.github/workflows/package-build.yml',
      'actions/checkout@v7.0.1',
      '$/.github/actions/setup-ffmpeg',
    ]);
  });
});

describe('classifyUses', () => {
  it('pins an action in a subfolder by its repository, owner and repository without case', () => {
    expect(classifyUses('actions/cache/restore@v6.1.0')).toEqual({ kind: 'action', pin: 'actions/cache@v6.1.0' });
    expect(classifyUses('Swatinem/rust-cache@v2.9.3')).toEqual({ kind: 'action', pin: 'swatinem/rust-cache@v2.9.3' });
    expect(classifyUses('octo/workflows/.github/workflows/x.yml@v1')).toEqual({ kind: 'action', pin: 'octo/workflows@v1' });
  });

  it('tells local composite actions from local reusable workflows', () => {
    expect(classifyUses('$/.github/actions/setup-ffmpeg')).toEqual({ kind: 'local-action', path: '.github/actions/setup-ffmpeg' });
    expect(classifyUses('./.github/actions/setup-ffmpeg/')).toEqual({ kind: 'local-action', path: '.github/actions/setup-ffmpeg' });
    expect(classifyUses('./.github/workflows/package-build.yml')).toEqual({
      kind: 'local-workflow',
      path: '.github/workflows/package-build.yml',
    });
    expect(classifyUses('docker://alpine:3')).toEqual({ kind: 'docker' });
  });

  it('refuses an action without a ref', () => {
    expect(() => classifyUses('actions/checkout')).toThrow(/actions\/checkout/);
  });
});

describe('parseActionsLock', () => {
  it('reads the workflow lists and the dependencies', () => {
    const lock = parseActionsLock(
      [
        '# This file is machine-generated by `gh actions-lock`.',
        "version: 'v0.0.3'",
        'workflows:',
        "    '.github/workflows/ci.yml':",
        "        - 'actions/checkout@v7.0.1'",
        "        - 'Swatinem/rust-cache@v2.9.3'",
        "    '.github/workflows/empty.yml':",
        'dependencies:',
        "    'actions/checkout@v7.0.1':",
        "        ref: 'v7.0.1'",
        "        commit: 'sha1-3d3c42e5aac5ba805825da76410c181273ba90b1'",
      ].join('\r\n'),
    );
    expect(lock.workflows).toEqual(
      new Map([
        ['.github/workflows/ci.yml', new Set(['actions/checkout@v7.0.1', 'swatinem/rust-cache@v2.9.3'])],
        ['.github/workflows/empty.yml', new Set()],
      ]),
    );
    expect(lock.dependencies).toEqual(new Set(['actions/checkout@v7.0.1']));
  });
});

describe('checkActionsLock', () => {
  let root: string;

  beforeEach(() => {
    root = mkdtempSync(join(tmpdir(), 'celesta-actions-lock-'));
    mkdirSync(join(root, '.github/workflows'), { recursive: true });
  });

  afterEach(() => {
    rmSync(root, { recursive: true, force: true });
  });

  const write = (path: string, lines: string[]) => {
    mkdirSync(dirname(join(root, path)), { recursive: true });
    writeFileSync(join(root, path), lines.join('\n') + '\n');
  };

  const lock = (workflows: Record<string, string[]>, dependencies: string[]) =>
    write(LOCK_PATH, [
      'workflows:',
      ...Object.entries(workflows).flatMap(([path, pins]) => [`    '${path}':`, ...pins.map((pin) => `        - '${pin}'`)]),
      'dependencies:',
      ...dependencies.flatMap((pin) => [`    '${pin}':`, `        ref: '${pin.split('@')[1]}'`]),
    ]);

  it("counts a composite action's actions, follows nested ones, and not reusable workflows", () => {
    write('.github/workflows/release.yml', [
      'jobs:',
      '  build:',
      '    uses: ./.github/workflows/build.yml',
      '  publish:',
      '    steps:',
      '      - uses: actions/checkout@v7.0.1',
      '      - uses: $/.github/actions/outer',
    ]);
    write('.github/workflows/build.yml', ['jobs:', '  b:', '    steps:', '      - uses: actions/upload-artifact@v7.0.2']);
    write('.github/actions/outer/action.yml', ['runs:', '  steps:', '    - uses: ./.github/actions/inner']);
    write('.github/actions/inner/action.yaml', [
      'runs:',
      '  steps:',
      '    - uses: actions/cache/restore@v6.1.0',
      '    - uses: actions/cache/save@v6.1.0',
      '    - uses: ./.github/actions/outer',
    ]);
    lock(
      {
        '.github/workflows/release.yml': ['actions/checkout@v7.0.1'],
        '.github/workflows/build.yml': ['actions/upload-artifact@v7.0.2'],
      },
      ['actions/checkout@v7.0.1', 'actions/upload-artifact@v7.0.2'],
    );

    const result = checkActionsLock(root);
    expect(result.workflows).toEqual(['.github/workflows/build.yml', '.github/workflows/release.yml']);
    expect(result.problems).toEqual([
      {
        file: '.github/workflows/release.yml',
        message:
          '.github/workflows/release.yml uses actions/cache@v6.1.0 (through .github/actions/inner/action.yaml), which its list in .github/workflows/actions.lock does not pin',
      },
    ]);
  });

  it('reports a workflow missing from the lock and a listed pin without a dependency', () => {
    write('.github/workflows/new.yaml', ['jobs:', '  a:', '    steps:', '      - uses: actions/checkout@v7.0.1']);
    write('.github/workflows/old.yml', ['jobs:', '  a:', '    steps:', '      - uses: Actions/Checkout@v7.0.1']);
    lock({ '.github/workflows/old.yml': ['actions/checkout@v7.0.1'] }, []);

    expect(checkActionsLock(root).problems.map(({ message }) => message)).toEqual([
      '.github/workflows/new.yaml uses actions/checkout@v7.0.1, which its list in .github/workflows/actions.lock does not pin',
      '.github/workflows/actions.lock lists actions/checkout@v7.0.1 for .github/workflows/old.yml but has no dependencies entry for it',
    ]);
  });

  it('refuses a local action without an action.yml', () => {
    write('.github/workflows/a.yml', ['jobs:', '  a:', '    steps:', '      - uses: ./.github/actions/gone']);
    lock({}, []);
    expect(() => checkActionsLock(root)).toThrow(/\.github\/workflows\/a\.yml: .*\.github\/actions\/gone\/action\.yml/);
  });
});

describe('check-actions-lock.mts', () => {
  let root: string;

  beforeEach(() => {
    root = mkdtempSync(join(tmpdir(), 'celesta-actions-lock-'));
    cpSync(join(repository, '.github'), join(root, '.github'), { recursive: true });
  });

  afterEach(() => {
    rmSync(root, { recursive: true, force: true });
  });

  const run = (...args: string[]) => {
    const env = { ...process.env };
    delete env.GITHUB_ACTIONS;
    return spawnSync(process.execPath, [script, ...args], { encoding: 'utf8', env });
  };

  it("passes on this repository's workflows", () => {
    const result = run();
    expect(result.stderr).toBe('');
    expect(result.status).toBe(0);
  });

  it("fails without plugin-release.yml's pin for setup-ffmpeg's actions/cache", () => {
    const path = join(root, LOCK_PATH);
    // A Windows checkout may have \r\n line endings.
    const text = readFileSync(path, 'utf8').replace(/\r\n/g, '\n');
    const list = /^ {4}'\.github\/workflows\/plugin-release\.yml':\n(?: {8}- .*\n)*/m.exec(text);
    expect(list?.[0]).toContain("        - 'actions/cache@v6.1.0'\n");
    writeFileSync(path, text.replace(list![0], list![0].replace("        - 'actions/cache@v6.1.0'\n", '')));

    const result = run(root);
    expect(result.status).toBe(1);
    expect(result.stderr).toContain(
      '.github/workflows/plugin-release.yml uses actions/cache@v6.1.0 (through .github/actions/setup-ffmpeg/action.yml)',
    );
  });
});
