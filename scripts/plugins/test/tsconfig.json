{
  // Type-checks the tests together with the scripts, which Node runs as they
  // are by stripping their types: only erasable syntax, explicit `.mts`
  // imports, and `import type` for what is only a type.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["./*.test.mts", "../*.mts", "../../report-skipped-tests.mts"]
}
