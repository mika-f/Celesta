{
  "name": "@celesta/website",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @celesta/web build && pnpm playground:build && pnpm run \"/^dev:/\"",
    "dev:playground": "vite build -c playground/vite.config.ts --watch",
    "dev:site": "makit dev",
    "build": "pnpm --filter @celesta/web build && wrangler types && tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && pnpm playground:build && makit build --clean && node --experimental-strip-types scripts/postbuild.mjs",
    "check": "makit check",
    "check:examples": "tsc -p tsconfig.examples.json",
    "playground:build": "vite build -c playground/vite.config.ts",
    "preview": "makit preview",
    "preview:cloudflare": "pnpm build && wrangler dev",
    "deploy:check": "pnpm build && wrangler deploy --dry-run",
    "deploy": "pnpm build && wrangler deploy",
    "test": "wrangler types && tsc -p tests && tsc -p tests/tsconfig.worker.json && vitest run"
  },
  "dependencies": {
    "@celesta/web": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "lucide-react": "0.577.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@natsuneko-laboratory/makit": "0.9.1",
    "@natsuneko-laboratory/makit-runtime": "0.9.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "next": "16.4.3",
    "remark-directive": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "wrangler": "^4.0.0"
  }
}
