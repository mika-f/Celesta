{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ],
    "jsx": "react-jsx",
    "resolveJsonModule": true
  },
  "include": [
    "site",
    "pages",
    "theme",
    "playground",
    "plugins",
    "makit.config.ts"
  ],
  "exclude": [
    "playground/demo/title-scene.tsx"
  ]
}
