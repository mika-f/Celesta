{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "vite/client"
    ],
    "jsx": "react-jsx",
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "vite.config.ts",
    "worker.ts",
    "worker-configuration.d.ts"
  ],
  "exclude": [
    "src/examples",
    "src/demo/title-scene.tsx"
  ]
}
