{
  "name": "@celesta.studio/cli",
  "version": "0.9.0",
  "private": true,
  "description": "The Node.js runtime the Celesta editor and exporter run React compositions in, with every Celesta package it serves to entries.",
  "license": "MIT OR Apache-2.0",
  "main": "./dist/cli.js",
  "bin": {
    "celesta-react-render": "./bin/celesta-react-render.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -b && node scripts/stage-project-types.mjs && node scripts/stage-templates.mjs",
    "test": "tsc -b test && vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@celesta.studio/aivis-speech": "workspace:*",
    "@celesta.studio/character": "workspace:*",
    "@celesta.studio/code": "workspace:*",
    "@celesta.studio/components": "workspace:*",
    "@celesta.studio/debug": "workspace:*",
    "@celesta.studio/layout": "workspace:*",
    "@celesta.studio/lottie": "workspace:*",
    "@celesta.studio/math": "workspace:*",
    "@celesta.studio/media-utils": "workspace:*",
    "@celesta.studio/project": "workspace:*",
    "@celesta.studio/react": "workspace:*",
    "@celesta.studio/shader": "workspace:*",
    "@celesta.studio/shapes": "workspace:*",
    "@celesta.studio/text": "workspace:*",
    "@celesta.studio/transitions": "workspace:*",
    "@celesta.studio/voicevox": "workspace:*",
    "esbuild": "^0.28.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "ag-psd": "^31.0.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  }
}
