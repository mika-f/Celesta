{
  "name": "@celesta/code",
  "version": "0.9.0",
  "private": true,
  "description": "Optional syntax-highlighted code components for Celesta compositions.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -b test && vitest run",
    "check:examples": "tsc -p tsconfig.examples.json"
  },
  "peerDependencies": {
    "@celesta/react": "0.0.0",
    "react": "^19.3.0"
  },
  "dependencies": {
    "@twinkleplop/bash": "^0.1.7",
    "@twinkleplop/core": "0.3.1",
    "@twinkleplop/json": "^0.1.7",
    "@twinkleplop/tsx": "^0.1.7",
    "@twinkleplop/typescript": "^0.1.7"
  },
  "devDependencies": {
    "@celesta/react": "workspace:*",
    "@celesta/text": "workspace:*",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "typescript": "^7.0.0",
    "vitest": "^5.0.3"
  }
}
