{
  "name": "@celesta.studio/web",
  "version": "0.9.0",
  "description": "Browser runtime, Canvas preview, and MP4 export for Celesta React compositions",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "files": ["dist", "README.md", "LICENSE-MIT", "LICENSE-APACHE"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "sideEffects": false,
  "scripts": {
    "test": "tsc -b test && vitest run",
    "build": "pnpm --filter \"@celesta.studio/cli^...\" build && tsc -p tsconfig.worker.json && vite build && tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "esbuild-wasm": "^0.28.2",
    "mediabunny": "^1.60.0"
  },
  "devDependencies": {
    "@celesta.studio/character": "workspace:*",
    "@celesta.studio/code": "workspace:*",
    "@celesta.studio/components": "workspace:*",
    "@celesta.studio/debug": "workspace:*",
    "@celesta.studio/layout": "workspace:*",
    "@celesta.studio/lottie": "workspace:*",
    "@celesta.studio/math": "workspace:*",
    "@celesta.studio/media-utils": "workspace:*",
    "@celesta.studio/react": "workspace:*",
    "@celesta.studio/shapes": "workspace:*",
    "@celesta.studio/text": "workspace:*",
    "@celesta.studio/transitions": "workspace:*",
    "@types/node": "^26.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
