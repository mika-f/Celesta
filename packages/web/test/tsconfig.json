{
  // Type-checks the tests together with the src/ they import, with the
  // package's own settings (DOM and Node types, Bundler resolution). `tsc -b
  // test` builds @celesta.studio/media-utils first when its dist/ is missing or
  // stale; this package itself needs no build.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    // The tests run on Node 22 and later, and use its newer built-ins
    // (`toReversed`, `Promise.withResolvers`).
    // The src/ the tests import is checked under this lib too; only the build
    // checks it against the package's own.
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "rootDir": "..",
    "tsBuildInfoFile": "../node_modules/.cache/test.tsbuildinfo"
  },
  "include": ["./**/*.mts"],
  "references": [{ "path": "../../media-utils" }]
}
