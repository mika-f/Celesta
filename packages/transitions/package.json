{
  "name": "@celesta/transitions",
  "version": "0.9.0",
  "private": true,
  "description": "Enter/exit transitions and TransitionSeries for Celesta compositions.",
  "license": "MIT OR Apache-2.0",
  "main": "./dist/index.js",
