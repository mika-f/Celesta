    "react": "^19.3.0"
  },
  "devDependencies": {
    "@celesta/react": "workspace:*",
    "@celesta/shader": "workspace:*",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  }
