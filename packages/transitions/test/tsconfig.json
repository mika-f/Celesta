{
  // Type-checks the tests together with the src/ they import. `tsc -b test`
  // builds the packages this one depends on first, when their dist/ is
  // missing or stale; this package itself needs no build.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "rootDir": "..",
    "tsBuildInfoFile": "../node_modules/.cache/test.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["./**/*.mts"],
  // The package's own references, plus @celesta.studio/shader, which only the tests use.
  "references": [
    { "path": "../../react" },
    { "path": "../../layout" },
    { "path": "../../math" },
    { "path": "../../shapes" },
    { "path": "../../shader" }
  ]
}
