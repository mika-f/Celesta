{
  // Type-checks the tests together with the src/ they import. `tsc -b test`
  // builds the packages this one depends on first, when their dist/ is
  // missing or stale; this package itself needs no build.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "noEmit": true,
    "rootDir": "..",
    "tsBuildInfoFile": "../node_modules/.cache/test.tsbuildinfo",
    // The tests use Array.prototype.at, Buffer and structuredClone.
    // The src/ the tests import is checked under this lib too; only the build
    // checks it against the package's own.
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["./**/*.ts"],
  // The package's tsconfig has no references; @celesta.studio/character is the
  // workspace package src/ and the tests import.
  "references": [{ "path": "../../character" }]
}
