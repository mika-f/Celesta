{
  "name": "@celesta/components",
  "version": "0.7.0",
  "private": true,
  "description": "High-level components for Celesta compositions: FrameChrome (corner brackets, title, timecode, chapter, and progress bar around the picture), PatternBackground (dots, grids, stripes, and custom repeating patterns), and Badge (a label on a background sized to its measured text).",
  "license": "MIT OR Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@celesta/math": "workspace:*"
  },
  "peerDependencies": {
    "@celesta/react": "0.0.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@celesta/react": "workspace:*",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  }
}
