{
  // Type-checks the tests together with the src/ they import. `tsc -b test`
  // builds `@celesta/math` first, when its dist/ is missing or stale; this
  // package itself needs no build.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "rootDir": "..",
    // The Node versions the tests run on have ES2022, as `Array#at`.
    // The src/ the tests import is checked under this lib too; only the build
    // checks it against the package's own.
    "lib": ["ES2022"],
    "tsBuildInfoFile": "../node_modules/.cache/test.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["./**/*.mts"],
  "references": [{ "path": "../../math" }]
}
