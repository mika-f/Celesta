{
  "name": "@celesta/react",
  "version": "0.9.0",
  "private": true,
  "description": "Core React components, hooks, and renderer for Celesta compositions, evaluated into the shared Rust Scene model.",
  "license": "MIT OR Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "default": "./dist/jsx-dev-runtime.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "codegen": "cd ../.. && cargo test -p celesta-project -p celesta-composition --features codegen",
    "build": "tsc -b tsconfig.json",
    "test": "tsc -b test && vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@celesta/math": "workspace:*",
    "react-reconciler": "^0.34.0"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-reconciler": "^0.34.0",
    "react": "^19.3.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  }
}
