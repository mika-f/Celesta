{
  "name": "@mikan/react",
  "version": "0.0.0",
  "private": true,
  "description": "Declarative React components for Mikan compositions, evaluated into the shared Rust Scene model.",
  "license": "MIT OR Apache-2.0",
  "main": "./dist/index.js",
