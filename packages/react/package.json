  },
  "dependencies": {
    "esbuild": "^0.24.2",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "@types/react": "^18.3.18",
    "typescript": "^5.7.3"
  }
}
